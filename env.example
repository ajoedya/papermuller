# ============================================================
#  SETTINGS FILE
#  1. Copy this file and rename the copy to:  .env
#  2. Change the values below. Lines starting with # are notes.
#  3. NEVER share your .env file: it holds your secret API key.
# ============================================================

# true  = practice mode with sample data (free, no internet needed)
# false = real mode (uses the configured AI provider + real paper databases)
DEMO_MODE=true

# WFLabs: https://api.wflabs.ai.id/v1 and a wf-... key.
# OpenRouter: https://openrouter.ai/api/v1 and a sk-or-... key.
# Other HTTPS OpenAI-compatible gateways are also supported.
LLM_BASE_URL=https://api.wflabs.ai.id/v1
LLM_API_KEY=
# Legacy key supported only when using OpenRouter
OPENROUTER_API_KEY=

# Default model for every AI stage. Select an exact ID from your provider's list.
# This WFLabs ID is an example from its guide; confirm access in your account.
# With OpenRouter, openrouter/free selects free models; openrouter/auto may cost.
# Optional fallback model IDs can be comma-separated.
MODEL=wf/glm-5.3-flash

# Choose a paper language before brainstorming/planning (independent of the UI).
# Set this in the app or here; e.g. Indonesian, French, English (UK), Japanese.
# Blank means no language chosen yet; existing saved choices are preserved.
LANGUAGE=

# ---- Literature search window and filters ----
# Publication years to include (inclusive). Leave TO_YEAR empty for this year.
FROM_YEAR=2015
TO_YEAR=
# any | article | review | article_review
WORK_TYPE=any
# true = only open-access works (easier to obtain full-text PDFs)
OPEN_ACCESS_ONLY=false
# Skip works cited fewer times than this (0 = no minimum)
MIN_CITATIONS=0

# How many candidate papers to verify, then how many the AI may keep after screening
CANDIDATES=30
MAX_PAPERS=12

# Quality gate: stop if fewer relevant, verified papers than this
MIN_VERIFIED=5

# Target: the reviewer's average score (1-10) a draft must reach
TARGET_SCORE=8

# Extra revision rounds after first draft (typically 3 AI calls per round: write, audit, review)
REVISION_ROUNDS=3

# ---- Optional per-stage models (leave empty to use MODEL) ----
# These can also be set by clicking a stage on the flowchart.
PLAN_MODEL=
SCREEN_MODEL=
EVIDENCE_MODEL=
# OUTLINE_MODEL falls back to WRITER_MODEL
OUTLINE_MODEL=
WRITER_MODEL=
VERIFIER_MODEL=
# A different reviewer model gives a more independent opinion
REVIEW_MODEL=
# REDTEAM_MODEL falls back to REVIEW_MODEL
REDTEAM_MODEL=
# PAPER_MODEL drafts the full paper; falls back to WRITER_MODEL
PAPER_MODEL=
# PAPER_REVIEW_MODEL runs the final review gate; falls back to REVIEW_MODEL
PAPER_REVIEW_MODEL=

# Optional: your email, sent to OpenAlex for faster, polite access
EMAIL=

# Free OpenAlex key (openalex.org -> sign up -> openalex.org/settings/api).
# Without it you get only a tiny daily budget.
OPENALEX_API_KEY=

# OpenRouter only: optional provider exclusions, comma-separated. Default empty.
IGNORE_PROVIDERS=

# Retrieve public open-access PDFs for selected papers, then read all extracted text in chunks.
# Uploaded PDFs are used even when automatic downloading is disabled.
FETCH_FULLTEXT=true
# Stop before drafting if any selected paper lacks usable full text.
REQUIRE_FULLTEXT=false
